POSTGRES_DB=smartgarden
POSTGRES_USER=smartgarden
# Gere senhas com: openssl rand -hex 16
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5432

# Senha do usuário MQTT do backend (smartgarden).
MQTT_PASSWORD=troque_esta_senha
MQTT_PORT=1883

# Usuário MQTT do ESP32 (igual ao DEVICE_CODE do firmware) e a senha dele.
# Use a mesma senha em smartgarden-firmware/esp32-dht22-serial/secrets.h (MQTT_PASSWORD).
MQTT_DEVICE_USER=esp32-jardim-bloco-a
MQTT_DEVICE_PASSWORD=troque_esta_senha
